                "history",
                "scenario"
              ],
              "title": "Source",
              "type": "string"
            }
          },
          {
            "in": "query",
            "name": "year",
            "required": false,
            "schema": {
              "default": 2025,
              "maximum": 2025,
              "minimum": 2017,
              "title": "Year",
              "type": "integer"
            }
          },
          {
            "in": "query",
            "name": "pathway",
            "required": false,
            "schema": {
              "default": "Holistic Transition",
              "title": "Pathway",
              "type": "string"
            }
          },
          {
            "in": "query",
            "name": "target",
            "required": false,
            "schema": {
              "default": 2030,
              "maximum": 2035,
              "minimum": 2030,
              "title": "Target",
              "type": "integer"
            }
          },
          {
            "in": "query",
            "name": "hours",
            "required": false,
            "schema": {
              "default": 2.0,
              "maximum": 8.0,
              "minimum": 0.5,
              "title": "Hours",
              "type": "number"
            }
          },
          {
            "in": "query",
            "name": "forecast",
            "required": false,
            "schema": {
              "default": "naive_last_week",
              "enum": [
                "naive_last_week",
                "perfect_foresight"
              ],
              "title": "Forecast",
              "type": "string"
            }
          },
          {
            "in": "query",
            "name": "services",
            "required": false,
            "schema": {
              "default": "none",
              "enum": [
                "none",
                "dc",
                "dc_dm"
              ],
              "title": "Services",
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "content": {
              "text/html": {
                "schema": {
                  "type": "string"
                }
              }
            },
            "description": "Successful Response"
          },
          "422": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            },
            "description": "Validation Error"
