    "/battery": {
      "get": {
        "description": "The full hourly report for one battery, run now.",
        "operationId": "battery_battery_get",
        "parameters": [
          {
            "in": "query",
            "name": "power_mw",
            "required": false,
            "schema": {
              "default": 1.0,
              "exclusiveMinimum": 0,
              "maximum": 1000,
              "title": "Power Mw",
              "type": "number"
            }
          },
          {
            "in": "query",
            "name": "source",
            "required": false,
            "schema": {
              "default": "history",
