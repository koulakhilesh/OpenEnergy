  "info": {
    "title": "OpenEnergy",
    "version": "5.0.1"
  },
  "openapi": "3.1.0",
  "paths": {
    "/api/compare": {
      "get": {
        "description": "Up to three precomputed results, named by their ``prices`` token, and every option.",
        "operationId": "compare_api_compare_get",
        "parameters": [
          {
            "in": "query",
            "name": "item",
            "required": false,
            "schema": {
              "default": [],
              "items": {
                "type": "string"
              },
              "maxItems": 3,
              "title": "Item",
              "type": "array"
            }
          },
          {
            "in": "query",
            "name": "hours",
            "required": false,
            "schema": {
              "default": "2",
              "enum": [
                "1",
                "2",
                "4"
              ],
              "title": "Hours",
              "type": "string"
            }
          },
          {
            "in": "query",
            "name": "forecast",
            "required": false,
            "schema": {
              "default": "naive_last_week",
              "enum": [
                "naive_last_week",
                "perfect_foresight"
              ],
              "title": "Forecast",
              "type": "string"
            }
          },
          {
            "in": "query",
            "name": "power_mw",
            "required": false,
            "schema": {
              "default": 1.0,
              "maximum": 1000.0,
              "minimum": 0.1,
              "title": "Power Mw",
              "type": "number"
            }
          }
        ],
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Compare"
                }
              }
            },
            "description": "Successful Response"
          },
          "400": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            },
            "description": "Bad Request"
          },
          "422": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            },
            "description": "Validation Error"
          },
          "503": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            },
            "description": "Service Unavailable"
          }
        },
        "summary": "Compare"
      }
    },
    "/api/explore": {
      "get": {
        "description": "Value by GB year (with ``services``) and by FES pathway, from the precomputed results.",
        "operationId": "explore_api_explore_get",
        "parameters": [
          {
            "in": "query",
            "name": "hours",
            "required": false,
            "schema": {
              "default": "2",
              "enum": [
                "1",
                "2",
                "4"
              ],
              "title": "Hours",
              "type": "string"
            }
          },
          {
            "in": "query",
            "name": "forecast",
            "required": false,
            "schema": {
              "default": "naive_last_week",
              "enum": [
                "naive_last_week",
                "perfect_foresight"
              ],
              "title": "Forecast",
              "type": "string"
            }
          },
          {
            "in": "query",
            "name": "services",
            "required": false,
            "schema": {
              "default": "none",
              "enum": [
                "none",
                "dc",
                "dc_dm"
              ],
              "title": "Services",
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Explore"
                }
              }
            },
            "description": "Successful Response"
          },
          "422": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            },
            "description": "Validation Error"
          },
          "503": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            },
            "description": "Service Unavailable"
          }
        },
        "summary": "Explore"
      }
    },
    "/api/options": {
      "get": {
        "description": "Everything the front end offers: years, pathways, limits and the \"?\" explanations.",
        "operationId": "options_api_options_get",
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Options"
                }
              }
            },
            "description": "Successful Response"
          }
        },
        "summary": "Options"
      }
    },
    "/api/result": {
      "get": {
        "description": "Per-MW results for one battery: precomputed when available, else run now.",
        "operationId": "result_api_result_get",
        "parameters": [
          {
            "in": "query",
            "name": "power_mw",
            "required": false,
            "schema": {
              "default": 1.0,
              "maximum": 1000.0,
              "minimum": 0.1,
              "title": "Power Mw",
              "type": "number"
            }
          },
          {
            "in": "query",
            "name": "source",
            "required": false,
            "schema": {
              "default": "history",
              "enum": [
                "history",
                "scenario"
              ],
              "title": "Source",
              "type": "string"
            }
          },
          {
            "in": "query",
            "name": "year",
            "required": false,
            "schema": {
              "default": 2025,
              "maximum": 2025,
              "minimum": 2017,
              "title": "Year",
              "type": "integer"
            }
          },
          {
            "in": "query",
            "name": "pathway",
            "required": false,
            "schema": {
              "default": "Holistic Transition",
              "title": "Pathway",
              "type": "string"
            }
          },
          {
            "in": "query",
            "name": "target",
            "required": false,
            "schema": {
              "default": 2030,
              "maximum": 2035,
              "minimum": 2030,
              "title": "Target",
              "type": "integer"
            }
          },
          {
            "in": "query",
            "name": "hours",
            "required": false,
            "schema": {
              "default": 2.0,
              "maximum": 8.0,
              "minimum": 0.5,
              "title": "Hours",
              "type": "number"
            }
          },
          {
            "in": "query",
            "name": "forecast",
            "required": false,
            "schema": {
              "default": "naive_last_week",
              "enum": [
                "naive_last_week",
                "perfect_foresight"
              ],
              "title": "Forecast",
              "type": "string"
            }
          },
          {
            "in": "query",
            "name": "services",
            "required": false,
            "schema": {
              "default": "none",
              "enum": [
                "none",
                "dc",
                "dc_dm"
              ],
              "title": "Services",
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ResultOut"
                }
              }
            },
            "description": "Successful Response"
          },
          "400": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            },
            "description": "Bad Request"
          },
          "422": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            },
            "description": "Validation Error"
          }
        },
        "summary": "Result"
      }
    },
    "/api/scenarios": {
      "get": {
        "description": "Each FES pathway's modelled results on the weather year next to NESO's own figures.",
        "operationId": "scenarios_api_scenarios_get",
        "responses": {
